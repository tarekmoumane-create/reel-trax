// Reel Trax — creator tracking OS
// Schema is intentionally portable: SQLite for local dev, Postgres for prod.
// No Prisma enums / Json columns so `provider` can be flipped with zero edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon direct (unpooled) connection — set by the Vercel↔Neon integration.
  url      = env("DATABASE_URL_UNPOOLED")
}

// A client = one of the brands/accounts you run creators for.
// The whole app scopes to the "current" client (the toggle in the top bar).
model Client {
  id        String    @id @default(cuid())
  name      String
  color     String     @default("#ec5a35") // fallback accent when there's no logo
  website   String? // client's site — used to auto-fetch their logo
  logoUrl   String? // client profile picture / brand logo

  // How this client pays creators.
  // "uniform": every creator is on the same structure (the default below).
  // "individual": each creator gets their own deal, starting from the default.
  payMode         String  @default("uniform") // uniform | individual
  defaultPayRules String? // JSON PayRulesJson — the client's default structure

  archived  Boolean    @default(false)
  createdAt DateTime   @default(now())
  creators  Creator[]
  campaigns Campaign[]
}

model Creator {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  displayName String
  // Profile picture. The platform CDN URL is signed and expires within days, so
  // we download the image once and keep the bytes — creators rarely change
  // their photo, and a stored copy costs no API credits and never breaks.
  avatarUrl  String? // where it came from (TikTok/IG CDN)
  avatarData Bytes? // the picture itself
  avatarMime String? // content type of avatarData
  avatarAt   DateTime? // when it was stored; set = "we have a photo, don't refetch"

  // TikTok
  tiktokHandle String?
  tiktokUrl    String?
  tiktokUserId String? // cached for faster ScrapeCreators lookups

  // Instagram
  instagramHandle String?
  instagramUrl    String?

  // YouTube (Shorts)
  youtubeHandle    String? // @handle without the "@"
  youtubeUrl       String?
  youtubeChannelId String? // UC… id, resolved on first sync when only a URL was given

  // Threads
  threadsHandle String?
  threadsUrl    String?

  // Where this creator came from (Sideshift is the common one)
  source       String  @default("sideshift") // sideshift | referral | outreach | agency | other
  sourceDetail String?
  sideshiftUrl String? // direct link to this creator's Sideshift chat (where you pay them)

  // How you actually pay this creator
  paymentMethod String  @default("sideshift") // sideshift | venmo | paypal | other
  paymentHandle String? // Venmo/PayPal username (Sideshift uses sideshiftUrl)

  // This creator's personal deal (JSON PayRulesJson), for clients on
  // individualized pay. Seeds their campaign overrides on assignment;
  // null = they're on the client/campaign default.
  payRules String?

  // Contact info
  phone         String?
  email         String?
  contactHandle String? // preferred DM handle / channel
  discord       String? // Discord username / handle
  discordChannel String? // link to the creator's channel in the client's Discord server
  whatsapp      String? // WhatsApp number if different from phone
  preferredChannel String? // sms | imessage | instagram | whatsapp | discord | email | other

  // Cadence expectation → drives the "behind / on track" flags
  expectedPerWeek Int    @default(7) // target posts per week
  status          String @default("active") // active | paused | inactive

  // When this creator was onboarded to the client (informational — nothing is
  // filtered by it; syncs still ingest their whole account history).
  onboardedAt DateTime?

  notes String?

  // Legacy — comms tracking was removed from the app. Columns stay so a
  // `db push` on deploy never has to drop data; nothing reads or writes them.
  lastContactedAt DateTime?
  followUpAt      DateTime?

  // Sync bookkeeping so you always know if data is fresh/stale
  lastSyncedAt   DateTime?
  lastSyncStatus String? // ok | error | never
  lastSyncError  String?

  createdAt DateTime @default(now())
  posts     Post[]

  campaignLinks CampaignCreator[]
  payouts       Payout[]
  followerSnapshots FollowerSnapshot[]
  statSnapshots     CreatorStatSnapshot[]

  @@index([clientId])
}

// Daily totals across a creator's tracked posts, captured during sync.
// Day-over-day differences give "views gained today" — the metric viral.app
// charts — which can't be recovered from post rows alone (those only hold the
// current total for each post).
model CreatorStatSnapshot {
  id         String   @id @default(cuid())
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  day        String // YYYY-MM-DD in the app timezone
  views      Int
  likes      Int
  comments   Int
  shares     Int
  posts      Int
  capturedAt DateTime @default(now())

  @@unique([creatorId, day])
  @@index([creatorId])
}

// Daily follower count per creator+platform, captured during sync, so we can
// chart follower growth over time.
model FollowerSnapshot {
  id         String   @id @default(cuid())
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform   String // tiktok | instagram
  day        String // YYYY-MM-DD in the app timezone
  followers  Int
  capturedAt DateTime @default(now())

  @@unique([creatorId, platform, day])
  @@index([creatorId])
}

// A campaign groups creators under a target + payout rules for one client.
model Campaign {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name   String
  status String @default("active") // active | paused | ended
  period String @default("monthly") // weekly | monthly — the billing cadence

  // The client's automatic campaign: mirrors the client's payment structure
  // and holds every creator not assigned to a manual campaign, so payouts
  // track with zero setup. Maintained by lib/autocampaign.ts — at most one
  // per client.
  isAuto Boolean @default(false)

  targetVideos Int? // target posts per period (optional)
  startDate    DateTime?
  endDate      DateTime?

  // Payout rules (per creator, per billing period)
  baseFee   Float  @default(0) // flat base
  perPost   Float  @default(0) // flat per qualifying post
  cpmRate   Float  @default(0) // $ per 1000 views
  // "aggregate": CPM on total qualifying views for the period.
  // "perVideo": CPM per video, each capped at cpmCapPerVideo when set —
  // that cap is what makes per-video CPM differ from aggregate.
  cpmBasis       String  @default("aggregate") // aggregate | perVideo
  cpmCapPerVideo Float? // max CPM earnings per video (perVideo basis)
  // JSON [{"views":100000,"bonus":50}] — a video reaching a tier pays that
  // tier's bonus (highest tier reached only). Alternative to CPM.
  viewTiers String?
  bonus     Float  @default(0) // flat bonus when target met
  minViews  Int    @default(0) // min views for a post to qualify
  // A video's views count only up to N days after posting — the deadline for
  // hitting minViews and the tiers, and the cutoff for CPM views.
  // Null = all-time (no deadline). Judged from PostStatSnapshot history.
  viewWindowDays Int?
  payoutCap Float? // max per creator per period
  currency  String @default("USD")

  createdAt   DateTime          @default(now())
  assignments CampaignCreator[]
  payouts     Payout[]

  @@index([clientId])
}

model CampaignCreator {
  id         String   @id @default(cuid())
  campaignId String
  creatorId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Per-creator overrides — null means "inherit the campaign rule".
  // Lets each creator run a completely different pay structure in one campaign.
  baseFee        Float?
  perPost        Float?
  cpmRate        Float?
  cpmBasis       String? // aggregate | perVideo
  cpmCapPerVideo Float?
  viewTiers      String? // JSON [{"views":n,"bonus":n}]
  bonus          Float?
  minViews       Int?
  viewWindowDays Int?
  payoutCap      Float?
  flatDeal       Float? // a fixed total for the period, ignoring all other rules
  note           String? // free text, e.g. "hybrid: $200 + rev share"

  @@unique([campaignId, creatorId])
  @@index([creatorId])
}

// A settled payout for one creator, one campaign, one billing period.
// Computed periods are shown live; a row is stored once you mark it paid/cancelled.
model Payout {
  id          String   @id @default(cuid())
  campaignId  String
  creatorId   String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  amount      Float
  currency    String    @default("USD")
  status      String    @default("paid") // paid | cancelled
  postsCount  Int       @default(0)
  viewsCount  Int       @default(0)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([campaignId, creatorId, periodStart])
  @@index([creatorId])
}

model Post {
  id             String  @id @default(cuid())
  creatorId      String
  creator        Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform       String // tiktok | instagram | youtube | threads
  platformPostId String

  url          String?
  caption      String?
  thumbnailUrl String?

  postedAt DateTime
  views    Int @default(0)
  likes    Int @default(0)
  comments Int @default(0)
  shares   Int @default(0)

  source    String   @default("auto") // auto | manual
  fetchedAt DateTime @default(now())

  // Pay components this video is excluded from, as a JSON array:
  // any of "perPost" | "cpm" | "tiers", or ["all"] to earn nothing at all.
  // null/empty = counts toward everything (the default).
  payExclusions String?
  // A warm-up post: earns no view-based pay (CPM / view bonuses) — the
  // creator posted it to prime the algorithm, not to perform.
  isWarmUp Boolean @default(false)
  // A fixed amount this one video pays instead of whatever the rules would
  // compute for it. Null = priced by the campaign rules.
  payOverride Float?

  snapshots PostStatSnapshot[]

  @@unique([platform, platformPostId])
  @@index([creatorId, postedAt])
}

// Daily view count per post, captured during sync for recent posts. This is
// what makes viewWindowDays judgeable: "views at day N after posting" is the
// snapshot on/just before that deadline. Posts older than the snapshot
// feature have no rows and fall back to current totals.
model PostStatSnapshot {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  day        String // YYYY-MM-DD in the app timezone
  views      Int
  capturedAt DateTime @default(now())

  @@unique([postId, day])
  @@index([postId])
}

// Key/value app config: ScrapeCreators API key, cron secret, sync cadence, etc.
model Setting {
  key   String @id
  value String
}
